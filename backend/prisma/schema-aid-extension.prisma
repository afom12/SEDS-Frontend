// AID COORDINATION SYSTEM EXTENSION
// This extends the existing schema to support needs-based aid coordination
// Add these models to your existing schema.prisma file

// ============================================
// AID TYPE SYSTEM
// ============================================

// Aid Type model - Defines what types of aid can be requested/offered
model AidType {
  id          String   @id @default(uuid())
  code        String   @unique // e.g., "FOOD_URGENT", "CLOTHING", "MEDICAL"
  name        String   // Display name
  nameAmharic String?  // Amharic name
  description String?  @db.Text
  
  // Category classification
  category    AidCategory
  
  // Characteristics
  isPerishable Boolean @default(false) // For food items
  requiresExpiration Boolean @default(false) // Must have expiry date
  allowsScheduling Boolean @default(true) // Can schedule future delivery
  requiresQuantity Boolean @default(true) // Needs quantity specification
  
  // Default urgency
  defaultUrgency UrgencyLevel @default(MEDIUM)
  
  // Relationships
  requests    AidRequest[]
  offers      AidOffer[]
  
  // Metadata
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("aid_types")
}

enum AidCategory {
  FOOD
  CLOTHING
  MEDICAL
  CASH
  EDUCATION
  SHELTER
  SERVICES
  OTHER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================
// ORGANIZATION MODEL
// ============================================

// Organization model - Trusted organizations that can verify requests
model Organization {
  id          String   @id @default(uuid())
  name        String
  nameAmharic String?
  description String?  @db.Text
  
  // Organization details
  type        OrganizationType
  registrationNumber String? // Official registration
  address     String?
  phone       String?
  email       String?
  website     String?
  
  // Verification
  verified    Boolean  @default(false)
  verifiedAt  DateTime?
  verifiedBy  String? // Admin user ID
  
  // Contact person
  contactPersonName String?
  contactPersonPhone String?
  contactPersonEmail String?
  
  // Relationships
  members     OrganizationMember[]
  verifiedRequests AidRequest[] // Requests verified by this org
  managedDeliveries Delivery[] // Deliveries managed by this org
  
  // Documents
  documents   Document[]
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([verified])
  @@index([type])
  @@map("organizations")
}

// Organization members (users who belong to organizations)
model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role           OrganizationRole @default(MEMBER)
  isActive       Boolean  @default(true)
  
  joinedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

enum OrganizationRole {
  ADMIN
  VERIFIER
  COORDINATOR
  MEMBER
}

